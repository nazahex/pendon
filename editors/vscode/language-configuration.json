{
  "comments": {
    "blockComment": [
      "<!--",
      "-->"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "comment",
        "string"
      ]
    },
    {
      "open": "{{",
      "close": "}}",
      "notIn": [
        "comment",
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "`",
      "`"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "<",
      ">"
    ],
    [
      "*",
      "*"
    ],
    [
      "_",
      "_"
    ],
    [
      "~",
      "~"
    ],
    [
      "|",
      "|"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:<!--\\s*#?region\\b.*-->|={2,7}[A-Za-z].*$)",
      "end": "^\\s*(?:<!--\\s*#?endregion\\b.*-->|={2,7}\\s*$)"
    }
  },
  "wordPattern": "(\\p{Alphabetic}|\\p{Number}|\\p{Nonspacing_Mark})(((\\p{Alphabetic}|\\p{Number}|\\p{Nonspacing_Mark})|[_])?(\\p{Alphabetic}|\\p{Number}|\\p{Nonspacing_Mark}))*",
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:[-*+]|\\d+\\.)\\s+$",
      "action": {
        "indent": "outdent"
      }
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:[-*+]|\\d+\\.)\\s+.+$|^\\s*={2,7}[A-Za-z].*$",
    "decreaseIndentPattern": "^\\s*={2,7}\\s*$"
  }
}
